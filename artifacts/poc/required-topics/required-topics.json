        "headings": [
          {
            "level": 1,
            "text": "記事作成の副業って?どうやって始めるの?"
          },
          {
            "level": 2,
            "text": "記事作成の副業とはどんな仕事?"
          },
          {
            "level": 3,
            "text": "WEB上に掲載するための記事を作成する仕事"
          },
          {
            "level": 3,
            "text": "クライアントとのやりとりはWEBで完結することが多い"
          },
          {
            "level": 3,
            "text": "多様なジャンルの仕事がある"
          },
          {
            "level": 2,
            "text": "記事作成の副業はいくら稼げるの?"
          },
          {
            "level": 3,
            "text": "記事作成の仕事は様々な要素によって単価が変わる"
          },
          {
            "level": 3,
            "text": "初心者は単価0.5円~1円の仕事から始めるのが一般的"
          },
          {
            "level": 3,
            "text": "スキルが上がると副業ライターで 月10万 円も可能"
          },
          {
            "level": 2,
            "text": "記事作成の副業はどうやって始めるの?"
          },
          {
            "level": 3,
            "text": "仕事はインターネットで探せる"
          },
          {
            "level": 3,
            "text": "最初はクラウドソーシングサービスを利用するのがおすすめ"
          },
          {
            "level": 3,
            "text": "文章力や執筆ジャンルの知識は自分で勉強する"
          },
          {
            "level": 2,
            "text": "副業で記事作成の仕事をするメリットは?"
          },
          {
            "level": 3,
            "text": "時間と場所を問わず仕事ができる"
          },
          {
            "level": 3,
            "text": "パソコン一台あれば仕事を始められる"
          },
          {
            "level": 3,
            "text": "自分のレベルに応じた仕事が見つかる"
          },
          {
            "level": 2,
            "text": "副業で記事作成の仕事をするデメリットは?"
          },
          {
            "level": 3,
            "text": "目が疲れる"
          },
          {
            "level": 3,
            "text": "高収入を得るには自分からのアクションが必要"
          },
          {
            "level": 3,
            "text": "クライアントとのやりとりで疲弊することもある"
          },
          {
            "level": 2,
            "text": "まとめ"
          },
          {
            "level": 2,
            "text": "関連記事"
          },
