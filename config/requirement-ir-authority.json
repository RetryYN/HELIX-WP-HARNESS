{
  "schema_version": "wp-requirement-authority.v1",
  "authority": "canonical",
  "canonical_schema": "config/requirement-ir-schema.json",
  "canonical_root": "requirements-ir/manifest.json",
  "generated_views": [],
  "compatibility_inputs": [
    "docs/requirements/l3/requirements-ir.json",
    "docs/requirements/l3/acceptance-cases.json",
    "docs/requirements/l3/traceability.json"
  ],
  "consumer_policy": {
    "semantic_read": "canonical_json_only",
    "legacy_json_and_markdown": "migration_and_compatibility_read_only",
    "generated_markdown": "read_only_view",
    "write": "json_transaction_only",
    "dual_authority": "forbidden"
  },
  "lifecycle_policy": {
    "current": "elicited_not_frozen",
    "freeze_authority": "PO",
    "fabricated_freeze": "forbidden"
  }
}
