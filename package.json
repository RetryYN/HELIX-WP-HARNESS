{
  "name": "helix-wp-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "helix": "tsx node_modules/helix/src/cli.ts",
    "requirements:validate": "node scripts/validate-requirements.mjs",
    "requirements:helix-l1-l2": "node scripts/validate-helix-l1-l2.mjs",
    "requirements:helix-vmodel": "npm run helix -- vmodel lint",
    "prototype:syntax": "node --check docs/prototypes/wp-ops-dashboard/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run requirements:validate && npm run requirements:helix-l1-l2 && npm run requirements:helix-vmodel && npm run prototype:syntax"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "helix": "github:RetryYN/HELIX-HARNESS#dcfbb845",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
