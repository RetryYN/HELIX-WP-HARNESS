{
  "name": "helix-wp-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "helix": "tsx node_modules/helix/src/cli.ts",
    "requirements:validate": "node scripts/validate-requirements.mjs",
    "requirements:helix-l1-l2": "node scripts/validate-helix-l1-l2.mjs",
    "requirements:helix-vmodel": "npm run helix -- vmodel lint",
    "poc:keyword-serp:test": "node scripts/test-keyword-serp.mjs",
    "poc:keyword-serp": "node scripts/poc-keyword-serp.mjs",
    "poc:keyword-serp:verify": "node scripts/verify-poc-evidence.mjs",
    "poc:keyword-intent-pair": "node scripts/poc-keyword-intent-pair.mjs",
    "poc:gsc-page-queries": "node scripts/poc-gsc-page-queries.mjs",
    "poc:keyword-article-match": "node scripts/poc-keyword-article-matching.mjs",
    "prototype:keyword-dashboard": "node scripts/serve-keyword-dashboard.mjs",
    "prototype:keyword-dashboard:db:build": "node scripts/build-keyword-dashboard-db.mjs",
    "prototype:keyword-dashboard:test": "node scripts/test-keyword-dashboard-integration.mjs",
    "poc:required": "npm run poc:keyword-serp:test && node scripts/test-keyword-article-matching.mjs && npm run poc:keyword-serp:verify && npm run prototype:keyword-dashboard:test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run requirements:validate && npm run requirements:helix-l1-l2 && npm run requirements:helix-vmodel && npm run poc:required"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "helix": "github:RetryYN/HELIX-HARNESS#dcfbb845",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "kuromoji": "^0.1.2"
  }
}
